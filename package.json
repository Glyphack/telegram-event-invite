{
  "name": "telegram-invite",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply telegram-invite-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply telegram-invite-db --remote",
    "set-webhook": "echo \"curl -X POST https://api.telegram.org/bot$BOT_TOKEN/setWebhook -H 'Content-Type: application/json' -d '{\\\"url\\\": \\\"$WORKER_URL/webhook\\\"}'\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250327.0",
    "typescript": "^5.7.0",
    "vitest": "~3.0.0",
    "wrangler": "^4.0.0"
  }
}
